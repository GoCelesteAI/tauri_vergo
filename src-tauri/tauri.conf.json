{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vergo",
  "version": "0.2.0",
  "identifier": "com.codegiz.vergo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vergo",
        "width": 560,
        "height": 420,
        "x": 280,
        "y": 120,
        "resizable": false,
        "center": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": ["http://localhost:8787/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRDN0JCRDdGMzM1RDkzNwpSV1EzMlRYejE3dkhCQ3FhRCtNRkJLdFBWbUhoNEY3UFpGSzZWUFFFd0pmSUFCSCs2bGVITTJ5VAo=",
      "dangerousInsecureTransportProtocol": true
    }
  }
}
